branch=$(git rev-parse --abbrev-ref HEAD)
pattern='^(main|(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/[a-z0-9]+(-[a-z0-9]+)*)$'
if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "Invalid branch name '$branch'. Use <type>/<kebab-description>, e.g. feat/push-to-talk-hotkey."
  exit 1
fi
